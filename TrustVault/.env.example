# Copy to .env for local runs (setup.bat does this for you with random values).
# Never commit .env. In production set these in the host's secret store instead.

# development | production   (production refuses to start without the three values below)
TRUSTVAULT_ENV=development

# Leave empty locally to use SQLite in .\instance\trustvault.db
# Production: postgresql://user:password@host:5432/dbname  (add ?sslmode=require for external hosts)

# Two DIFFERENT random secrets, 32+ characters each:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TRUSTVAULT_MASTER_KEY=6a1cefd7bfd14c90e57c476d5e8f683a9e9b381882fb8f3202f05f12f9621bfd
TRUSTVAULT_AUDIT_KEY=47897daba837f50140ae5710f0ca6dc03a31bf60427d69c4078f3dba3cc3cec6

TRUSTVAULT_DEMO_MODE=true
TRUSTVAULT_SEED_DEMO=true

# Optional tuning (defaults shown)
# TRUSTVAULT_SECURE_COOKIES=false          # true automatically in production (needs HTTPS)
# TRUSTVAULT_TRUST_PROXY_HOPS=0            # 1 behind Render/Heroku-style proxies
# TRUSTVAULT_SESSION_IDLE_MINUTES=30
# TRUSTVAULT_SESSION_ABSOLUTE_HOURS=8
# TRUSTVAULT_MAX_UPLOAD_MB=10
# TRUSTVAULT_USER_QUOTA_MB=100
# TRUSTVAULT_UPLOADS_PER_HOUR=60
# TRUSTVAULT_LOGIN_MAX_FAILURES=5
# TRUSTVAULT_LOGIN_WINDOW_MINUTES=15
# TRUSTVAULT_RATE_LIMIT_PER_MINUTE=300
